# ==============================================================================
# Courseit Learning Tracker - Environment Variables
# ==============================================================================
# The application operates in high-performance local-first mode by default.
# Configuring Supabase is OPTIONAL and enables multi-device cloud synchronization.
# ==============================================================================

# Supabase Cloud Configuration (Optional)
# Obtain these from your Supabase Project Settings > API:
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Application Base URL (Used for Canonical URLs, OpenGraph, and Sitemap generation)
NEXT_PUBLIC_APP_URL=https://courseit.vercel.app

# Environment Mode: development | staging | production
NEXT_PUBLIC_APP_ENV=production
