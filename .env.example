# ==============================================================================
# Learnhour - Environment Variables
# ==============================================================================
# Guest mode is local-first. Supabase enables account authentication only; courses
# and study records do not currently sync to Supabase or between devices.
# ==============================================================================

# Optional Supabase Auth. Keep disabled until provider settings and redirect URLs
# have been configured and verified in the Supabase project.
NEXT_PUBLIC_SUPABASE_AUTH_ENABLED=false
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Set to the canonical HTTPS origin before deployment, for example https://learnhour.example
NEXT_PUBLIC_APP_URL=

# Optional public support address, used on the Contact page when provided.
NEXT_PUBLIC_SUPPORT_EMAIL=
